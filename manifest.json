{
    "manifest_version": 2,
    "short_name": "quoteWithout",
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "version": "1.1.1",
    "browser_specific_settings": {
        "gecko": {
            "id": "quote-without@addons.thunderbird.net",
            "strict_min_version": "136.0"
        }
    },
